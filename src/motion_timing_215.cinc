/* Motion-only cut detection. Shadow replay retains its original motion guard. */
static BOOL motion_camera_cut(float distance_squared,float seconds)
{
    if(!(seconds>0.0001f&&seconds<=0.50f))return TRUE;
    float limit=max(4.0f,240.0f*seconds);
    return !(distance_squared>=0.0f&&distance_squared<=limit*limit);
}
static float motion_shutter_scale(int degrees,float seconds,BOOL valid_step)
{
    if(!valid_step||degrees<=0||!(seconds>0.0001f&&seconds<=0.50f))return 0.0f;
    return (degrees/360.0f)*(1.0f/60.0f)/max(seconds,1.0f/240.0f);
}
static void matrix_column_major(float *out,const float *in,int transpose)
{
    for(int row=0;row<4;row++)for(int col=0;col<4;col++)out[col*4+row]=transpose?in[row*4+col]:in[col*4+row];
}
