/* Artistic lighting looks; no astronomy/game-time/physics modification. */
void ui_lighting_preset(int look)
{
    static const int preset[8][7]={
        /* sun elevation, turn, haze, night blend, weather, moon, stars */
        {0,0,0,0,0,100,100},{12,85,55,0,0,100,100},{65,160,10,0,0,100,100},
        {14,240,35,0,0,100,100},{8,270,55,40,0,100,100},
        {40,180,55,0,1,100,100},{0,0,12,100,0,45,90},{0,0,18,100,0,140,160}
    };
    wchar_t path[MAX_PATH],section[80],value[32];const int *p;
    if(look<0||look>7)return;p=preset[look];
    log_path(path,L"mxs-shaders.ini");pack_section(section,80);
#define LOOK(var,key,n) do{var=(n);swprintf_s(value,32,L"%d",var);WritePrivateProfileStringW(section,L##key,value,path);}while(0)
#define GLOBAL(var,key,n) do{var=(n);swprintf_s(value,32,L"%d",var);WritePrivateProfileStringW(L"mxs-shaders",L##key,value,path);}while(0)
    LOOK(g_cfg_sun_height,"sun_height",p[0]);LOOK(g_cfg_sun_turn,"sun_turn",p[1]);
    LOOK(g_cfg_fog,"fog",p[2]);LOOK(g_cfg_time_of_day,"time_of_day",p[3]);
    GLOBAL(g_cfg_weather,"weather",p[4]);LOOK(g_cfg_weather_amount,"weather_amount",p[4]==1?85:20);
    GLOBAL(g_cfg_moon,"moonlight",p[5]);GLOBAL(g_cfg_stars,"star_brightness",p[6]);
    GLOBAL(g_cfg_sky_mode,"sky_mode",look==7?2:look==6?1:0);
    GLOBAL(g_cfg_light_look,"lighting_preset",look);
    if(look==0)LOOK(g_cfg_wet,"wet",0);
#undef LOOK
#undef GLOBAL
}
