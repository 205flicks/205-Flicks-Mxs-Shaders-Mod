/* Surface colors and contact share the tire probe. All particles are render-only. */
#define ROOST_BATCH 72
#define ROOST_COUNT (ROOST_BATCH * 6)
static GLuint roost_program;
static float roost_pos[ROOST_COUNT][4],roost_vel[ROOST_COUNT][4],roost_tint[ROOST_COUNT][4];
static float tire_soil[2][3],tire_amount[2],roost_last,roost_rider_last;
static unsigned roost_next;
static void (WINAPI *roost_Uniform4fv)(GLint,GLsizei,const float *);
static void (WINAPI *roost_DepthMask)(GLboolean);

void surface_clear(void)
{
    memset(roost_vel,0,sizeof roost_vel);
    memset(tire_amount,0,sizeof tire_amount);
    roost_last=roost_rider_last=0.0f;
}
float surface_coat(int wheel,float soil[3])
{
    int source=tire_amount[wheel]>0.0f?wheel:1-wheel;
    memcpy(soil,tire_soil[source],sizeof tire_soil[source]);
    return max(tire_amount[0],tire_amount[1]);
}
static void surface_load(void)
{
    if(roost_program)gl_DeleteProgram(roost_program);
    roost_program=0;
    char *v=pack_load("surface_roost.vsh"),*f=pack_load("surface_roost.fsh");
    GLuint vs=0,fs=0;
    if(v&&f){vs=compile(GL_VERTEX_SHADER,v,"surface roost vertex");fs=compile(GL_FRAGMENT_SHADER,f,"surface roost fragment");}
    free(v);free(f);
    if(vs&&fs){
        GLint ok=0;
        roost_program=gl_CreateProgram();
        gl_AttachShader(roost_program,vs);gl_AttachShader(roost_program,fs);gl_LinkProgram(roost_program);
        gl_GetProgramiv(roost_program,GL_LINK_STATUS,&ok);
        if(!ok){gl_DeleteProgram(roost_program);roost_program=0;}
    }
    if(vs)gl_DeleteShader(vs);
    if(fs)gl_DeleteShader(fs);
    *(PROC*)&roost_Uniform4fv=marks_get_proc("glUniform4fv");
    *(FARPROC*)&roost_DepthMask=GetProcAddress(g_real_gl,"glDepthMask");
}
static void surface_emit(const marks_frame *f,int i,const float sample[4],const float previous[3],float dt)
{
    BOOL valid_tint=sample[3]>=1.0f;
    const float *p=f->wheels[i].bottom;
    float x=p[0]-previous[0],z=p[2]-previous[2],distance=(float)sqrt(x*x+z*z);
    if(dt<=0.0f||dt>0.30f||distance<0.025f||distance>f->wheels[i].radius*12.0f)return;
    float gain=1.0f-expf(-distance*0.14f);
    float target[3]={0.43f,0.31f,0.22f};
    if(valid_tint)memcpy(target,sample,sizeof target);
    else if(tire_amount[i]>0.0f)memcpy(target,tire_soil[i],sizeof target);
    else if(tire_amount[1-i]>0.0f)memcpy(target,tire_soil[1-i],sizeof target);
    if(valid_tint&&(f->surface_enabled&1)){
    for(int c=0;c<3;c++)tire_soil[i][c]+=(target[c]-tire_soil[i][c])*(tire_amount[i]>0.01f?gain:1.0f);
    tire_amount[i]=min(0.72f,tire_amount[i]+gain*0.36f);
    }
    if(i!=1||f->time-roost_rider_last<0.085f||!(f->surface_enabled&6))return;
    roost_last=roost_rider_last=f->time;
    for(int j=0;j<2;j++){
        unsigned k=roost_next++%ROOST_COUNT;
        float spread=((float)((roost_next*43u)%97u)/96.0f-0.5f)*2.0f;
        float push=1.85f;
        memcpy(roost_pos[k],p,3*sizeof(float));
        roost_pos[k][1]+=0.14f;roost_pos[k][3]=f->time;
        roost_vel[k][0]=-x/distance*push+z/distance*spread*2.6f;
        roost_vel[k][2]=-z/distance*push-x/distance*spread*2.6f;
        roost_vel[k][1]=0.66f+fabs(spread)*0.42f;
        roost_vel[k][3]=1.35f;
        for(int c=0;c<3;c++)roost_tint[k][c]=
            min(1.0f,target[c]*0.83f+0.11f);
        roost_tint[k][3]=0.0f;
    }
}
void surface_draw(const float *view,const float *projection,float now,GLboolean depth_write,int flags,float amount)
{
    if(amount<=0.0f||!(flags&6)||!roost_program||!roost_Uniform4fv||!roost_DepthMask||roost_last<=0.0f||now-roost_last>1.60f)return;
    mark_gl_state state;
    GLboolean points=gl_IsEnabled(0x8642);
    mk_capture(&state);
    gl_Enable(GL_DEPTH_TEST);gl_Enable(GL_BLEND);gl_Enable(0x8642);
    roost_DepthMask(0);
    gl_BlendFunc(0x0302,0x0303);
    mk_BlendEquationSeparate(0x8006,0x8006);
    gl_UseProgram(roost_program);
    gl_UniformMatrix4fv(gl_GetUniformLocation(roost_program,"u_view"),1,0,view);
    gl_UniformMatrix4fv(gl_GetUniformLocation(roost_program,"u_projection"),1,0,projection);
    gl_Uniform1f(gl_GetUniformLocation(roost_program,"u_now"),now);
    gl_Uniform1f(gl_GetUniformLocation(roost_program,"u_height"),(float)state.viewport[3]);
    GLint position=gl_GetUniformLocation(roost_program,"u_position[0]");
    GLint velocity=gl_GetUniformLocation(roost_program,"u_velocity[0]");
    GLint tint=gl_GetUniformLocation(roost_program,"u_tint[0]");
    gl_Uniform1f(gl_GetUniformLocation(roost_program,"u_amount"),amount);
    for(unsigned first=0;first<ROOST_COUNT;first+=ROOST_BATCH){
        BOOL active=FALSE;
        for(unsigned i=first;i<first+ROOST_BATCH;i++){
            float age=now-roost_pos[i][3];
            if(age>=0.0f&&age<roost_vel[i][3]){active=TRUE;break;}
        }
        if(!active)continue;
        roost_Uniform4fv(position,ROOST_BATCH,&roost_pos[first][0]);
        roost_Uniform4fv(velocity,ROOST_BATCH,&roost_vel[first][0]);
        roost_Uniform4fv(tint,ROOST_BATCH,&roost_tint[first][0]);
        gl_DrawArrays(0x0000,0,ROOST_BATCH);
    }
    roost_DepthMask(depth_write);
    if(!points)gl_Disable(0x8642);
    mk_restore(&state);
}
