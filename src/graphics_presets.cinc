/* Presets exchange only numeric settings exposed by this menu. */
#include <commdlg.h>
/* Resolve relative to the game executable even if launched from a shortcut. */
static BOOL graphics_preset_directory(wchar_t path[MAX_PATH])
{
    DWORD length=GetModuleFileNameW(NULL,path,MAX_PATH);
    if(!length||length>=MAX_PATH)return FALSE;
    wchar_t *name=wcsrchr(path,L'\\');
    if(!name)return FALSE;
    if(wcscpy_s(name+1,MAX_PATH-(name+1-path),L"205 Flicks MXS Shaders Mod Presets"))
        return FALSE;
    if(CreateDirectoryW(path,NULL))return TRUE;
    DWORD attributes=GetFileAttributesW(path);
    return attributes!=INVALID_FILE_ATTRIBUTES && (attributes&FILE_ATTRIBUTE_DIRECTORY);
}

void ui_graphics_file(HWND window,BOOL save)
{
    typedef BOOL (WINAPI *dialog_fn)(LPOPENFILENAMEW);
    HMODULE module=LoadLibraryW(L"comdlg32.dll");
    if(!module)return;
    dialog_fn dialog=(dialog_fn)GetProcAddress(module,save?"GetSaveFileNameW":"GetOpenFileNameW");
    wchar_t file[MAX_PATH]=L"",path[MAX_PATH],section[80],value[32],directory[MAX_PATH];
    OPENFILENAMEW options={0};
    options.lStructSize=sizeof options;
    options.hwndOwner=window;
    options.lpstrFilter=L"205 Shaders Preset (*.205shaderspreset)\0*.205shaderspreset\0Legacy presets\0*.205preset;*.205 Shaders Preset\0";
    options.lpstrDefExt=save?NULL:L"205preset";
    if(graphics_preset_directory(directory)){
        options.lpstrInitialDir=directory;
        if(save)
            swprintf_s(file,MAX_PATH,L"%ls\\Graphics.205shaderspreset",directory);
    }
    options.lpstrFile=file;
    options.nMaxFile=MAX_PATH;
    options.Flags=OFN_NOCHANGEDIR|OFN_PATHMUSTEXIST|(save?OFN_OVERWRITEPROMPT:OFN_FILEMUSTEXIST);
    if(!dialog||!dialog(&options)){FreeLibrary(module);return;}
    FreeLibrary(module);
    log_path(path,L"mxs-shaders.ini");
    if(save){
        const wchar_t suffix[]=L".205shaderspreset";
        size_t length=wcslen(file), tail=wcslen(suffix);
        if(length<tail||_wcsicmp(file+length-tail,suffix)!=0){
            if(length+tail>=MAX_PATH)return;
            memcpy(file+length,suffix,sizeof suffix);
            if(GetFileAttributesW(file)!=INVALID_FILE_ATTRIBUTES&&
               MessageBoxW(window,L"Replace the existing preset?",L"205 Shaders Preset",MB_YESNO|MB_ICONQUESTION)!=IDYES)return;
        }
        FILE *out=_wfopen(file,L"wb");
        if(!out)return;
        fputs("[205 Flicks]\r\nversion=1\r\n",out);
        for(unsigned i=0;i<sizeof g_ui_items/sizeof *g_ui_items;i++){
            char line[160];
            sprintf_s(line,sizeof line,"%ls=%d\r\n",g_ui_items[i].key,*g_ui_items[i].value);
            fputs(line,out);
        }
        fclose(out);
        return;
    }
    if(GetPrivateProfileIntW(L"205 Flicks",L"version",0,file)!=1)return;
    for(unsigned i=0;i<sizeof g_ui_items/sizeof *g_ui_items;i++){
        const ui_item *item=&g_ui_items[i];
        wchar_t *end;
        if(!GetPrivateProfileStringW(L"205 Flicks",item->key,L"",value,32,file))continue;
        long number=wcstol(value,&end,10);
        if(end==value||*end)continue;
        if(item->kind==UI_TOGGLE)number=number!=0;
        else if(item->kind==UI_SLIDER)number=max(item->min,min(item->max,number));
        else {
            BOOL found=FALSE;
            for(int j=0;j<item->choice_count;j++)if(number==item->choices[j])found=TRUE;
            if(!found)continue;
        }
        wcscpy_s(section,80,L"mxs-shaders");
        if(item->value==&g_cfg_sun_height||item->value==&g_cfg_sun_turn||item->value==&g_cfg_blur_enabled||item->value==&g_cfg_samples||
           (item->kind==UI_SLIDER&&item->tab==UI_TAB_LOOK))
            pack_section(section,80);
        swprintf_s(value,32,L"%ld",number);
        WritePrivateProfileStringW(section,item->key,value,path);
    }
    load_live_settings();
}
