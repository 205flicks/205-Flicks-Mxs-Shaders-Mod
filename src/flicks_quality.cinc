/* 205 Flicks controls: ordinary GL uniforms and our settings file only. */
static void quality_uniforms(GLuint p)
{
    if(!p||!my_glProgramUniform1f)return;
#define Q(name,value) my_glProgramUniform1f(p,real_glGetUniformLocation(p,name),(float)(value))
    Q("u_205_active",1);Q("u_205_moon",NIGHT_MOON_BRIGHTNESS);Q("u_205_stars",NIGHT_STAR_BRIGHTNESS);
    Q("u_205_roughness",0.70f);Q("u_205_normal",1.0f);
    Q("u_205_micro",0.20f);Q("u_205_reflection",0.60f);
    Q("u_205_material",g_cfg_material_light/100.0f);Q("u_205_ambient",g_cfg_ambient/100.0f);
    Q("u_205_bike_materials",g_cfg_bike_materials);
    Q("u_205_stadium",g_cfg_stadium_preset);
    if(p==g_terrain_prog){
        float terrain_occlusion=min(0.30f,g_cfg_ao*0.0013f+g_cfg_contact*0.0010f);
        Q("u_205_terrain_occlusion",my_glIsEnabled(0x0BE2 /* GL_BLEND */)?-1.0f:terrain_occlusion);
        GLuint grooves=g_cfg_tire_tracks?marks_compaction_texture():0;
        Q("u_205_track_packed_on",grooves!=0);
        if(grooves){
            my_glProgramUniform1i(p,real_glGetUniformLocation(p,"u_205_track_packed"),24);
            real_glActiveTexture(GL_TEXTURE0+24);
            real_glBindTexture(GL_TEXTURE_2D,grooves);
        }
        if(grooves)real_glActiveTexture(g_active_unit);
    }
#undef Q
}
void ui_quality_preset(int level)
{
    wchar_t path[MAX_PATH],text[32];
    level=max(0,min(level,2));
    log_path(path,L"mxs-shaders.ini");
    /* Presets do not touch the user depth-of-field or sun/weather/look values. */
#define SET(var,key,v) do{var=(v);swprintf_s(text,32,L"%d",var);WritePrivateProfileStringW(L"mxs-shaders",L##key,text,path);}while(0)
    SET(g_cfg_msaa,"msaa",level==2?2:level==0?4:8);
    SET(g_cfg_aniso,"anisotropy",level==2?8:16);
    SET(g_cfg_shadow_size,"shadow_size",level==2?2048:level==0?4096:8192);
    SET(g_cfg_ao_samples,"ao_samples",level==2?12:level==0?16:32);
    SET(g_cfg_ao_quality,"ao_quality",level==1?2:1);
    SET(g_cfg_samples,"motion_samples",level==2?6:12);
#undef SET
    log_msg("205 Flicks quality preset %d: MSAA and shadow quality changes after restart",level);
}
