/* Independent geometric wheel recognition near the current local rider pose.
 * Does not use camera positions as tire locations or read game physics/memory.
 */
typedef struct {float center[3],normal[3],radius,width;unsigned id;} wheel_candidate;
static wheel_candidate wheel_candidates[64];
static GLuint tire_history_terrain;
static int wheel_candidate_count;
static float tracks_wheel_radius[2];
static unsigned tracks_wheel_frame;
static float tracks_wheel_center[2][3];
static BOOL tracks_wheel_valid;
static int tracks_capture_attempts,tracks_bounds_ok;
static BOOL tracks_pair_was_valid;
static unsigned tracks_last_notice;
#include "tracks_bounds.cinc"
static void wheel_transform(const mesh_sphere *shape,const float *mv,unsigned id)
{
    float world[16],scale[3],h[3],normal[3],center[3],radius,width;
    int small=0,a,b,i,j;
    if(!shape)return;
    mat_mul(world,g_prev_inv_view,mv);
    for(i=0;i<3;i++){
        scale[i]=(float)sqrt(world[i*4]*world[i*4]+world[i*4+1]*world[i*4+1]+world[i*4+2]*world[i*4+2]);
        h[i]=shape->half[i]*scale[i];
        if(h[i]<h[small])small=i;
    }
    a=(small+1)%3;b=(small+2)%3;
    if(h[a]<=0.0f||h[b]<=0.0f||h[small]>min(h[a],h[b])*0.52f||max(h[a],h[b])>min(h[a],h[b])*1.22f)return;
    radius=(h[a]+h[b])*0.5f;
    if(radius<0.12f||radius>2.2f)return;
    for(i=0;i<3;i++)normal[i]=world[small*4+i]/max(scale[small],1e-5f);
    if(fabs(normal[1])>0.985f)return;
    for(i=0;i<3;i++)center[i]=world[i]*shape->x+world[4+i]*shape->y+world[8+i]*shape->z+world[12+i];
    width=max(radius*0.18f,min(radius*0.65f,h[small]*2.0f));
    for(j=0;j<wheel_candidate_count;j++){
        float d=0;for(i=0;i<3;i++){float v=center[i]-wheel_candidates[j].center[i];d+=v*v;}
        if(d<radius*radius*0.12f){
            if(radius<=wheel_candidates[j].radius*1.02f&&width<=wheel_candidates[j].width)return;
            break;
        }
    }
    if(j>=64)return;if(j==wheel_candidate_count)wheel_candidate_count++;
    for(i=0;i<3;i++){wheel_candidates[j].center[i]=center[i];wheel_candidates[j].normal[i]=normal[i];}
    wheel_candidates[j].radius=radius;wheel_candidates[j].width=width;wheel_candidates[j].id=id;
}
static void tracks_hook_capture(GLsizei count,GLenum type,const void *indices)
{
    uni_entry *mv;float matrix[16];int i,j;
    if(!g_cfg_enabled||g_cur_prog!=g_model_prog||g_cur_nbones!=0||g_cur_fb!=0)return;
    mv=model_uniform("u_modelview");if(!mv||!mv->data)return;
    for(i=0;i<4;i++)for(j=0;j<4;j++)matrix[i*4+j]=mv->transpose?((float*)mv->data)[j*4+i]:((float*)mv->data)[i*4+j];
    /* Broad phase only: these are real wheel mesh positions, never a camera
       trail. Avoid reading distant scene buffers. Final ownership is checked
       against this frame's rider bones at commit, after all meshes are drawn. */
    if(matrix[12]*matrix[12]+matrix[13]*matrix[13]+matrix[14]*matrix[14]>180.0f*180.0f)return;
    tracks_capture_attempts++;
    const mesh_sphere *shape=tracks_draw_bounds(count,type,indices);
    if(shape)tracks_bounds_ok++;
    wheel_transform(shape,matrix,g_cur_vao);
}
static BOOL tracks_near_rider(const wheel_candidate *w,const float *actor_mv)
{
    float radius=max(4.0f,w->radius*6.0f);
    if(g_pose_bones<=0)return FALSE;
    for(int b=0;b<g_pose_bones;b++){
        float view[3],world[3],d[3];const float *t=g_pose_t[b];
        for(int i=0;i<3;i++)view[i]=actor_mv[i]*t[0]+actor_mv[4+i]*t[1]+actor_mv[8+i]*t[2]+actor_mv[12+i];
        for(int i=0;i<3;i++){
            world[i]=g_prev_inv_view[i]*view[0]+g_prev_inv_view[4+i]*view[1]+g_prev_inv_view[8+i]*view[2]+g_prev_inv_view[12+i];
            d[i]=w->center[i]-world[i];
        }
        if(v_dot(d,d)<=radius*radius)return TRUE;
    }
    return FALSE;
}
typedef struct {wheel_candidate wheels[2];unsigned seen;} extra_bike;
static extra_bike extra_bikes[31];
static void tracks_extra_bikes(const marks_frame *base,int first,int second)
{
    BOOL used[64]={0}, assigned[31]={0};
    if(first>=0){used[first]=TRUE;used[second]=TRUE;}
    for(int i=0;i<wheel_candidate_count;i++){
        if(used[i])continue;
        const wheel_candidate *a=&wheel_candidates[i];
        int partner=-1;
        float best=1e20f;
        for(int j=i+1;j<wheel_candidate_count;j++){
            if(used[j])continue;
            const wheel_candidate *b=&wheel_candidates[j];
            float r=(a->radius+b->radius)*0.5f,d[3];
            for(int k=0;k<3;k++)d[k]=a->center[k]-b->center[k];
            float length=(float)sqrt(v_dot(d,d));
            if(length<r*3.4f||length>r*6.3f||fabs(d[1])>r*2.8f||
               min(a->radius,b->radius)<max(a->radius,b->radius)*0.72f||
               fabs(v_dot(a->normal,b->normal))<0.56f)continue;
            if(fabs(v_dot(a->normal,d))/length>0.56f||fabs(v_dot(b->normal,d))/length>0.56f)continue;
            float score=fabs(length/r-4.7f);
            if(score<best){best=score;partner=j;}
        }
        if(partner<0)continue;
        const wheel_candidate *b=&wheel_candidates[partner];
        int slot=-1,free_slot=-1,swap=0;
        best=50.0f;
        for(int k=0;k<31;k++){
            extra_bike *old=&extra_bikes[k];
            if(assigned[k])continue;
            if(!old->seen||g_frame-old->seen>10){if(free_slot<0)free_slot=k;continue;}
            float forward=0,reverse=0;
            for(int q=0;q<3;q++){
                float x=a->center[q]-old->wheels[0].center[q],y=b->center[q]-old->wheels[1].center[q];
                float u=b->center[q]-old->wheels[0].center[q],v=a->center[q]-old->wheels[1].center[q];
                forward+=x*x+y*y;reverse+=u*u+v*v;
            }
            if(min(forward,reverse)<best){best=min(forward,reverse);slot=k;swap=reverse<forward;}
        }
        if(slot<0){slot=free_slot;swap=a->radius<b->radius;}
        if(slot<0)break;
        extra_bike *bike=&extra_bikes[slot];
        marks_frame frame=*base;
        frame.valid=1;
        for(int k=0;k<2;k++){
            const wheel_candidate *w=(k^swap)?b:a;
            mark_wheel *out=&frame.wheels[k];
            float down[3]={w->normal[0]*w->normal[1],w->normal[1]*w->normal[1]-1.0f,w->normal[2]*w->normal[1]};
            float len=(float)sqrt(v_dot(down,down));
            for(int q=0;q<3;q++)out->bottom[q]=w->center[q]+down[q]*w->radius/max(len,0.0001f);
            memcpy(out->center,w->center,sizeof out->center);
            memcpy(out->axis,w->normal,sizeof out->axis);
            out->geometric=1;out->radius=w->radius;out->width=w->width;out->id=w->id^(k?0x10000000u:0x20000000u);
            bike->wheels[k]=*w;
        }
        bike->seen=g_frame;
        used[i]=used[partner]=assigned[slot]=TRUE;
        marks_select_rider((unsigned)slot+1);
        marks_submit(&frame);
    }
    marks_select_rider(0);
}
static void tracks_hook_commit(void)
{
    marks_frame f;float actor_mv[16];BOOL owned[64]={0};int i,j,best_a=-1,best_b=-1;float best=0,best_score=0;
    static unsigned front_id,rear_id;
    static float previous_mid[3],previous_front[3],label_travel[3];static BOOL have_mid;
    memset(&f,0,sizeof f);
    f.time=g_weather_time;f.spacing=g_terrain_spacing;f.heights=g_terrain_heights;
    if(g_terrain_heights<MAX_IDS){f.height_w=g_tex[g_terrain_heights].w;f.height_h=g_tex[g_terrain_heights].h;}
    f.surface_enabled=g_cfg_enabled?surface_flags():0;
    f.surface=g_surface_tex;
    f.interval=1.0f/20.0f; f.contact=25;
    f.texscale=g_surface_scale; f.wet=weather_wet();
    if(f.surface_enabled&&g_shadow_frame){
        matrix_column_major(actor_mv,g_pose_mv,g_tracks_pose_transpose);
        /* Hidden first-person wheels can be reconstructed only after their meshes
           and rigid-to-bone relationships have been learned in a chase view. */
        if(wheel_candidate_count<2&&g_pose_bones>0){
            for(i=0;i<g_rigid_parts;i++){
                const rigid_part *part=&g_rigid[i];int bone=g_rigid_bone[part->group];
                float pose[16],placed[16],local[16];
                if(part->vao>=MAX_IDS||g_mesh_sphere_state[part->vao]!=SPHERE_KNOWN||bone<0||bone>=g_pose_bones)continue;
                bone_matrix(local,bone);mat_mul(pose,actor_mv,local);mat_mul(placed,pose,part->relative[bone]);
                /* Use the same per-draw bounds learned while this part was visible.
                   A shared VBO may contain the entire bike, not one wheel. */
                const mesh_sphere *shape=tracks_cached_bounds(part->vao,part->count,part->type,part->indices);
                if(shape)wheel_transform(shape,placed,part->vao);
            }
        }
        for(i=0;i<wheel_candidate_count;i++)owned[i]=tracks_near_rider(&wheel_candidates[i],actor_mv);
        for(i=0;i<wheel_candidate_count;i++)for(j=i+1;j<wheel_candidate_count;j++){
            
            const wheel_candidate *a=&wheel_candidates[i],*b=&wheel_candidates[j];
            float r=(a->radius+b->radius)*0.5f,d=0,parallel=0;
            int k;for(k=0;k<3;k++){float v=a->center[k]-b->center[k];d+=v*v;parallel+=a->normal[k]*b->normal[k];}
            d=(float)sqrt(d);
            if(min(a->radius,b->radius)<max(a->radius,b->radius)*0.72f||d<r*3.0f||d>r*7.0f||fabs(parallel)<0.48f||fabs(a->center[1]-b->center[1])>r*3.0f)continue;
            float score=r;
            if(owned[i]&&owned[j])score+=5.0f;
            else if(owned[i]||owned[j])score+=1.0f;
            float view_distance=0.0f;
            for(int q=0;q<3;q++){
                float delta=0.5f*(a->center[q]+b->center[q])-g_prev_inv_view[12+q];
                view_distance+=delta*delta;
            }
            score-=0.0005f*view_distance;
            if(front_id&&rear_id&&((a->id==front_id&&b->id==rear_id)||(a->id==rear_id&&b->id==front_id)))score+=2.2f;
            if(best_a<0||score>best_score){best_score=score;best=r;best_a=i;best_b=j;}
        }
        if(best_a>=0){
            wheel_candidate *a=&wheel_candidates[best_a],*b=&wheel_candidates[best_b];
            float mid[3],travel[3],lead=0,movement=0;int order[2]={best_a,best_b};BOOL newly_assigned=FALSE,front_b=FALSE;
            for(i=0;i<3;i++){
                mid[i]=(a->center[i]+b->center[i])*0.5f;travel[i]=mid[i]-previous_mid[i];
                if(have_mid)label_travel[i]+=travel[i];
                lead+=(a->center[i]-b->center[i])*label_travel[i];movement+=label_travel[i]*label_travel[i];
            }
            if((front_id!=a->id&&front_id!=b->id)||(rear_id!=a->id&&rear_id!=b->id)){
                if(have_mid&&movement>best*best*0.0025f){front_id=lead>=0?a->id:b->id;rear_id=lead>=0?b->id:a->id;newly_assigned=TRUE;front_b=lead<0;}
                else{front_id=rear_id=0;}
            }
            if(!newly_assigned){
                if(a->id!=b->id)front_b=front_id==b->id;
                else if(front_id&&have_mid){float da=0,db=0;for(i=0;i<3;i++){float pa=a->center[i]-(previous_front[i]+travel[i]),pb=b->center[i]-(previous_front[i]+travel[i]);da+=pa*pa;db+=pb*pb;}front_b=db<da;}
            }
            if(front_b){order[0]=best_b;order[1]=best_a;}
            f.valid=front_id!=0;
            if(f.valid){tracks_wheel_valid=TRUE;tracks_wheel_frame=g_frame;}
            if(f.valid)memset(label_travel,0,sizeof label_travel);
            for(j=0;j<2;j++){
                wheel_candidate *w=&wheel_candidates[order[j]];
                if(f.valid)tracks_wheel_radius[j]=w->radius;
                if(f.valid)memcpy(tracks_wheel_center[j],w->center,sizeof w->center);
                float down[3]={w->normal[0]*w->normal[1],-1.0f+w->normal[1]*w->normal[1],w->normal[2]*w->normal[1]};
                float len=(float)sqrt(v_dot(down,down));
                for(i=0;i<3;i++)f.wheels[j].bottom[i]=w->center[i]+down[i]/max(len,1e-5f)*w->radius;
                memcpy(f.wheels[j].center,w->center,sizeof w->center);
                memcpy(f.wheels[j].axis,w->normal,sizeof w->normal);
                f.wheels[j].geometric=1;
                f.wheels[j].radius=w->radius;f.wheels[j].width=w->width;f.wheels[j].id=w->id^(j?0x10000000u:0x20000000u);
            }
            memcpy(previous_front,wheel_candidates[order[0]].center,sizeof previous_front);
            memcpy(previous_mid,mid,sizeof mid);have_mid=TRUE;
        }else{have_mid=FALSE;memset(label_travel,0,sizeof label_travel);}
    }else{have_mid=FALSE;memset(label_travel,0,sizeof label_travel);}
    if(f.surface_enabled&&g_shadow_frame&&(f.valid!=tracks_pair_was_valid||g_frame-tracks_last_notice>=600)){
        log_msg("205 v2.1.11 tires: pair=%d candidates=%d measured=%d near_draws=%d rider=%d bones=%d shadow_parts=%d terrain=%u %dx%d spacing=%.5f",
            f.valid,wheel_candidate_count,tracks_bounds_ok,tracks_capture_attempts,g_rider_seen,g_pose_bones,g_rigid_parts,f.heights,f.height_w,f.height_h,f.spacing);
        if(f.valid)log_msg("205 v2.1.11 wheel footprint: front r=%.3f width=%.3f bottom=(%.3f,%.3f,%.3f); rear r=%.3f width=%.3f bottom=(%.3f,%.3f,%.3f)",
            f.wheels[0].radius,f.wheels[0].width,f.wheels[0].bottom[0],f.wheels[0].bottom[1],f.wheels[0].bottom[2],
            f.wheels[1].radius,f.wheels[1].width,f.wheels[1].bottom[0],f.wheels[1].bottom[1],f.wheels[1].bottom[2]);
        tracks_last_notice=g_frame;
    }
    tracks_pair_was_valid=f.valid;
    marks_submit(&f);
    if(f.surface_enabled&&g_shadow_frame)tracks_extra_bikes(&f,best_a,best_b);
    wheel_candidate_count=0;tracks_capture_attempts=tracks_bounds_ok=0;
}

/* A validated tread draw keeps its last coating through short pairing
 * gaps. Current draw geometry still determines where the coating is applied. */
typedef struct {
    GLuint vao;
    GLsizei count;
    GLenum type;
    const void *indices;
    unsigned seen;
    float point[3],local[3],soil[3],coat,radius;
} tire_draw_history;
static tire_draw_history tire_draws[128];

static float tracks_tire_coat(GLsizei count,GLenum type,const void *indices,float soil[3],float center[3],float *radius)
{
    if(tire_history_terrain!=g_terrain_heights){memset(tire_draws,0,sizeof tire_draws);tire_history_terrain=g_terrain_heights;}
    if(!count)return 0.0f;
    const mesh_sphere *shape=tracks_cached_bounds(g_cur_vao,count,type,indices);
    const uni_entry *mv=model_uniform("u_modelview");
    if(!mv||!mv->data)return 0.0f;
    float actor[16],world[16],point[3],local[3],half[3];
    matrix_column_major(actor,mv->data,mv->transpose);
    mat_mul(world,g_prev_inv_view,actor);
    tire_draw_history *cached=NULL,*oldest=&tire_draws[0];
    float closest=144.0f;
    for(int k=0;k<128;k++){
        tire_draw_history *entry=&tire_draws[k];
        if(entry->seen<oldest->seen)oldest=entry;
        if(entry->vao!=g_cur_vao||entry->count!=count||entry->type!=type||entry->indices!=indices||
           !entry->seen||g_frame-entry->seen>90)continue;
        float delta[3];
        for(int j=0;j<3;j++)
            delta[j]=world[12+j]+world[j]*entry->local[0]+world[4+j]*entry->local[1]+world[8+j]*entry->local[2]-entry->point[j];
        float d=v_dot(delta,delta);
        if(d<closest){closest=d;cached=entry;}
    }
    if(!shape&&!cached)return 0.0f;
    if(cached)memcpy(local,cached->local,sizeof local);
    else {local[0]=shape->x;local[1]=shape->y;local[2]=shape->z;}
    int thin=0;
    for(int j=0;j<3;j++){
        point[j]=world[12+j]+world[j]*local[0]+world[4+j]*local[1]+world[8+j]*local[2];
        half[j]=shape?shape->half[j]*(float)sqrt(v_dot(world+4*j,world+4*j)):0.0f;
        if(half[j]<half[thin])thin=j;
    }
    float a=half[(thin+1)%3],b=half[(thin+2)%3],r=(a+b)*0.5f;
    if(r<=0.0f||half[thin]>min(a,b)*0.53f||max(a,b)>min(a,b)*1.24f){
        if(!cached)return 0.0f;
        r=cached->radius;
    }
    int wheel=-1;
    float nearest=r*r*0.42f;
    if(tracks_wheel_valid&&g_frame-tracks_wheel_frame<=24)for(int i=0;i<2;i++){
        if(r<tracks_wheel_radius[i]*0.54f||r>tracks_wheel_radius[i]*1.65f)continue;
        float delta[3];
        for(int j=0;j<3;j++)delta[j]=point[j]-tracks_wheel_center[i][j];
        float d=v_dot(delta,delta);
        if(d<nearest){nearest=d;wheel=i;}
    }
    unsigned rider=0;
    for(int k=0;k<31;k++)if(extra_bikes[k].seen&&g_frame-extra_bikes[k].seen<=24)
        for(int i=0;i<2;i++){
            const wheel_candidate *w=&extra_bikes[k].wheels[i];
            if(r<w->radius*0.54f||r>w->radius*1.65f)continue;
            float delta[3];
            for(int j=0;j<3;j++)delta[j]=point[j]-w->center[j];
            float d=v_dot(delta,delta);
            if(d<nearest){nearest=d;wheel=i;rider=(unsigned)k+1;}
        }
    float coat=0.0f;
    if(wheel>=0){
        marks_select_rider(rider);
        coat=surface_coat(wheel,soil);
        marks_select_rider(0);
        *radius=rider?extra_bikes[rider-1].wheels[wheel].radius:tracks_wheel_radius[wheel];
    }
    if(coat<=0.0f){
        if(!cached)return 0.0f;
        memcpy(soil,cached->soil,sizeof cached->soil);
        coat=cached->coat;
        *radius=cached->radius;
    }
    if(coat<=0.0f)return 0.0f;
    for(int j=0;j<3;j++)center[j]=actor[12+j]+actor[j]*local[0]+actor[4+j]*local[1]+actor[8+j]*local[2];
    tire_draw_history *entry=cached?cached:oldest;
    *entry=(tire_draw_history){.vao=g_cur_vao,.count=count,.type=type,.indices=indices,.seen=g_frame,.coat=coat,.radius=*radius};
    memcpy(entry->local,local,sizeof entry->local);
    memcpy(entry->point,point,sizeof entry->point);
    memcpy(entry->soil,soil,sizeof entry->soil);
    return coat;
}

typedef struct {
    GLuint vao;
    GLsizei count;
    GLenum type;
    const void *indices;
    unsigned frame, confirmed_frame;
    float world_origin[3], step[3];
    BOOL have_profile;
    float floor[3], forward[3], up[3];
} dirt_mesh_history;

static dirt_mesh_history *dirt_mesh_match(GLsizei count, GLenum type, const void *indices, BOOL bike)
{
    static dirt_mesh_history history[128];
    static GLuint terrain;
    if(terrain!=g_terrain_heights){
        memset(history,0,sizeof history);
        terrain=g_terrain_heights;
    }
    BOOL identified=g_cur_nbones?blur_local_skinned_draw():bike;
    if(!count)return NULL;
    const uni_entry *mv=model_uniform("u_modelview");
    if(!mv||!mv->data)return NULL;
    float model[16],world[16],origin[3];
    matrix_column_major(model,mv->data,mv->transpose);
    mat_mul(world,g_prev_inv_view,model);
    memcpy(origin,world+12,sizeof origin);
    if(g_cur_nbones){
        const uni_entry *bones=model_uniform("u_bone_t");
        if(!bones||!bones->data||bones->count<1)return NULL;
        const float *root=bones->data;
        for(int i=0;i<3;i++)
            origin[i]+=world[i]*root[0]+world[4+i]*root[1]+world[8+i]*root[2];
    }
    dirt_mesh_history *match=NULL,*previous_profile=NULL,*oldest=&history[0];
    float nearest=identified?25.0f:(g_blur_remote_near?0.36f:4.0f);
    for(unsigned i=0;i<sizeof history/sizeof history[0];i++){
        dirt_mesh_history *item=&history[i];
        unsigned age=g_frame-item->frame;
        if(!item->count || (oldest->count && age>g_frame-oldest->frame))oldest=item;
        if(!item->count || item->vao!=g_cur_vao || item->count!=count ||
           item->type!=type || item->indices!=indices)continue;
        if(item->have_profile)previous_profile=item;
        if(age>12 || g_frame-item->confirmed_frame>45)continue;
        if(!identified && g_blur_remote_near && age>2)continue;
        float delta[3];
        for(int j=0;j<3;j++)
            delta[j]=origin[j]-item->world_origin[j]-min(age,4)*item->step[j];
        float distance=v_dot(delta,delta);
        if(distance<nearest){match=item;nearest=distance;}
    }
    if(!identified && !match)return NULL;
    if(!match){
        match=oldest;
        dirt_mesh_history saved_profile={0};
        if(previous_profile)saved_profile=*previous_profile;
        *match=(dirt_mesh_history){.vao=g_cur_vao,.count=count,.type=type,
            .indices=indices,.frame=g_frame,.confirmed_frame=g_frame};
        match->have_profile=saved_profile.have_profile;
        memcpy(match->floor,saved_profile.floor,sizeof match->floor);
        memcpy(match->forward,saved_profile.forward,sizeof match->forward);
        memcpy(match->up,saved_profile.up,sizeof match->up);
        memcpy(match->world_origin,origin,sizeof origin);
    }else if(g_frame!=match->frame){
        float elapsed=(float)(g_frame-match->frame);
        for(int i=0;i<3;i++)
            match->step[i]=(origin[i]-match->world_origin[i])/elapsed;
        memcpy(match->world_origin,origin,sizeof origin);
        match->frame=g_frame;
    }
    if(identified)match->confirmed_frame=g_frame;
    return match;
}

/* Use the tracked wheel pair as an actor-relative floor and forward axis.
   Only the followed rider and positively matched bike draws receive dirt. */
static float tracks_actor_dirt(GLsizei count,GLenum type,const void *indices,
                               float soil[3],float floor_point[3],float forward[3],float up[3],BOOL bike)
{
    static unsigned updated, previous_frame, wheel_update;
    static GLuint terrain;
    static BOOL have_anchor;
    static float previous[3],baseline,heading[3],floor_offset=3.0f;
    static BOOL have_heading;
    static float coating, coating_soil[3];
    dirt_mesh_history *mesh=dirt_mesh_match(count,type,indices,bike);
    if(!mesh)return 0.0f;
    if(!g_blur_anchor_valid||g_blur_anchor_terrain!=g_terrain_heights)return 0.0f;
    if(terrain!=g_terrain_heights){
        terrain=g_terrain_heights;
        baseline=coating=0.0f;
        wheel_update=g_frame-1;
        floor_offset=3.0f;
        have_anchor=have_heading=FALSE;
    }
    if(g_blur_anchor_frame==g_frame && (!have_anchor || updated!=g_frame)){
        float delta[3];
        for(int i=0;i<3;i++)delta[i]=g_blur_anchor[i]-previous[i];
        float travel=(float)sqrt(delta[0]*delta[0]+delta[2]*delta[2]);
        if(have_anchor && g_frame-previous_frame<=2 && travel<5.0f)
            baseline=min(0.45f,baseline+travel*0.03f);
        memcpy(previous,g_blur_anchor,sizeof previous);
        updated=previous_frame=g_frame;
        have_anchor=TRUE;
    }

    float floor[3],direction[3];
    BOOL wheels=tracks_wheel_valid&&g_frame-tracks_wheel_frame<=8;
    if(wheels && wheel_update!=g_frame){
        wheel_update=g_frame;
        float front_soil[3],rear_soil[3];
        marks_select_rider(0);
        float front=surface_coat(0,front_soil),rear=surface_coat(1,rear_soil);
        if(front+rear>0.0f){
            coating=max(coating,max(front,rear));
            for(int i=0;i<3;i++)
                coating_soil[i]=(front_soil[i]*front+rear_soil[i]*rear)/(front+rear);
        }
        if(g_blur_anchor_frame==g_frame){
            float bottom=(tracks_wheel_center[0][1]+tracks_wheel_center[1][1]
                         -tracks_wheel_radius[0]-tracks_wheel_radius[1])*0.5f;
            float offset=g_blur_anchor[1]-bottom;
            if(offset>0.5f&&offset<7.0f)floor_offset=0.8f*floor_offset+0.2f*offset;
        }
    }
    for(int i=0;i<3;i++){
        static const float dry_soil[]={0.43f,0.31f,0.22f};
        soil[i]=coating>0.0f?coating_soil[i]:dry_soil[i];
        floor[i]=g_blur_anchor[i];
        direction[i]=wheels?tracks_wheel_center[0][i]-tracks_wheel_center[1][i]:-g_prev_inv_view[8+i];
    }
    floor[1]-=floor_offset;
    direction[1]=0.0f;
    if(wheels&&v_normalize(direction)){
        memcpy(heading,direction,sizeof heading);
        have_heading=TRUE;
    }else if(have_heading)memcpy(direction,heading,sizeof direction);
    else if(!v_normalize(direction))return 0.0f;
    float amount=max(baseline,coating);
    if(amount<=0.0f)return 0.0f;
    if(!mesh->have_profile){
        const uni_entry *mv=model_uniform("u_modelview");
        if(!mv||!mv->data)return 0.0f;
        float model[16],world[16];
        matrix_column_major(model,mv->data,mv->transpose);
        if(g_cur_nbones){
            const uni_entry *r=model_uniform("u_bone_r"),*t=model_uniform("u_bone_t"),
                            *c=model_uniform("u_bone_c");
            if(!r||!t||!c||!r->data||!t->data||!c->data||
               r->count<1||t->count<1||c->count<1)return 0.0f;
            float root[16];
            const float *rotation=r->data,*position=t->data,*rest=c->data;
            for(int i=0;i<3;i++)for(int j=0;j<3;j++)
                root[4*i+j]=rotation[r->transpose?3*j+i:3*i+j];
            for(int i=0;i<3;i++){
                root[12+i]=position[i]-root[i]*rest[0]-root[4+i]*rest[1]-root[8+i]*rest[2];
                root[4*i+3]=0.0f;
            }
            root[15]=1.0f;
            mat_mul(world,model,root);
            memcpy(model,world,sizeof model);
        }
        mat_mul(world,g_prev_inv_view,model);
        float relative_floor[3];
        for(int i=0;i<3;i++)relative_floor[i]=floor[i]-world[12+i];
        for(int i=0;i<3;i++){
            const float *axis=world+4*i;
            float scale=(float)sqrt(v_dot(axis,axis));
            if(scale<0.001f)return 0.0f;
            mesh->floor[i]=v_dot(relative_floor,axis)/(scale*scale);
            mesh->forward[i]=v_dot(direction,axis)/scale;
            mesh->up[i]=axis[1]/scale;
        }
        mesh->have_profile=TRUE;
    }
    memcpy(floor_point,mesh->floor,sizeof mesh->floor);
    memcpy(forward,mesh->forward,sizeof mesh->forward);
    memcpy(up,mesh->up,sizeof mesh->up);
    return amount;
}
